# Copy this file to .env and set values appropriate for your environment.
# Never commit .env or real API keys.

# Optional provider key. Required only for LLM classification and Q&A.
GROQ_API_KEY=
SECONDSELF_LLM_MODEL=llama-3.1-8b-instant

# Storage paths are resolved relative to the repository root when relative.
SECONDSELF_RAW_DIR=raw
SECONDSELF_WIKI_DIR=wiki
SECONDSELF_DATA_DIR=data
SECONDSELF_STATIC_DIR=static
SECONDSELF_GRAPH_PATH=data/graph.json

# Local embedding and retrieval settings.
SECONDSELF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SECONDSELF_SIMILARITY_THRESHOLD=0.65
SECONDSELF_TOP_K=5
SECONDSELF_MAX_RELATED_NOTES=5
SECONDSELF_MAX_CONTENT_CHARS=12000
